# Copy to `.env` and/or `.env.local`, then fill real values. Never commit filled files.
#
# Rotation (regenerate if ever leaked or committed): MONGODB_URI, BLOB_READ_WRITE_TOKEN,
# IMGBB_API_KEY, SSO_CLIENT_SECRET, SESSION_SECRET.

# --- Camera app database (Atlas: cluster hostname is not the database name) ---
MONGODB_URI=REDACTED_ROTATE_ME_2026-08-14
MONGODB_DB=camera

# Optional pool tuning (Atlas + serverless)
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=0

# --- SSO OAuth / OIDC ---
SSO_BASE_URL=https://sso.example.com
SSO_CLIENT_ID=
# Optional: used for signed OAuth state / refresh if your SSO accepts it. Public OAuth clients still require PKCE on authorize + token exchange.
SSO_CLIENT_SECRET=
# Default is PKCE. Set to 1 or true only when this app is registered as a confidential client on SSO (PKCE optional); requires SSO_CLIENT_SECRET. Public clients on SSO will return invalid_request without PKCE.
# SSO_CONFIDENTIAL_OAUTH=
# Set to 1 or true to force PKCE even when SSO_CONFIDENTIAL_OAUTH would apply (e.g. testing).
# SSO_USE_PKCE=
# The OAuth redirect_uri is derived from the incoming request (/api/auth/callback);
# there is no redirect-URI variable.

# --- Vercel Blob (primary image storage: submissions / frames / logos) ---
# Create the store in the Vercel dashboard (Storage tab) as Public access -- this mode
# is fixed permanently at creation. Vercel-deployed code authenticates automatically via
# OIDC; only code running off-Vercel needs this token (camera's upload-capable CLI
# scripts, for example the picture backfills under scripts/).
BLOB_READ_WRITE_TOKEN=

# --- imgbb (best-effort secondary mirror only -- unreliable as a primary store, see
# RELEASE_NOTES.md; a missing key here just disables the mirror, uploads still work) ---
IMGBB_API_KEY=

# --- Email notifications (submission share links) ---
# Uses Resend when RESEND_API_KEY is set. RESEND and EMAIL_API_KEY are accepted as
# aliases (lib/email/send.ts). In production, set CAMERA_EMAIL_FROM to your verified
# sender domain; the per-event sender name is stored on the event, not in env.
RESEND_API_KEY=
CAMERA_EMAIL_FROM="Camera <photos@example.com>"
# Recipient for `npm run email:test` (EMAIL_TEST_TO is accepted as an alias).
RESEND_TEST_TO=

# --- fanmass internal read auth (server-to-server pull) ---
# Shared secret fanmass uses to pull events + event media for analysis:
#   GET ${NEXT_PUBLIC_APP_URL}/api/internal/fanmass/events
#   GET ${NEXT_PUBLIC_APP_URL}/api/internal/fanmass/events/{eventId}/media?since=<ISO>
CAMERA_FANMASS_INTERNAL_SECRET=

# --- messmass -> camera provisioning auth (server-to-server) ---
# Shared secret messmass uses to create/link camera organisations, partners and
# events (messmass is the master). Sent as x-messmass-secret or Bearer to:
#   POST ${NEXT_PUBLIC_APP_URL}/api/internal/messmass/{organizations,partners,events}
CAMERA_MESSMASS_INTERNAL_SECRET=

# --- savetheworld -> camera provisioning auth (server-to-server) ---
# Shared secret savetheworld uses to create/link the camera partner + event for
# its pledge campaign. Sent as x-savetheworld-secret or Bearer to:
#   POST ${NEXT_PUBLIC_APP_URL}/api/internal/savetheworld/{partners,events}
# Same secret also authenticates savetheworld's read-back of published pledge
# selfies for its public wall:
#   GET ${NEXT_PUBLIC_APP_URL}/api/internal/savetheworld/pledges?eventId=<id>
CAMERA_SAVETHEWORLD_INTERNAL_SECRET=

# Base URL of the savetheworld app. When set, each newly provisioned event gets a
# default CTA custom page sending the fan from their finished selfie straight to
# savetheworld's per-event offers screen; unset leaves customPages empty (no-op).
# Real value: https://savetheplanet.vercel.app
SAVETHEWORLD_APP_URL=

# --- camera -> messmass partner sync (server-to-server, reverse direction) ---
# Base URL of messmass, used ONLY to push camera-native partners (created
# directly in camera's own admin UI) back into messmass -- see lib/messmassClient.ts.
# Reuses CAMERA_MESSMASS_INTERNAL_SECRET above as the shared secret (same trust
# boundary, both directions). Partners synced messmass -> camera are never
# pushed back (loop-prevention via the `source` field on each partner doc).
MESSMASS_BASE_URL=http://localhost:3001

# --- App URLs ---
# Absolute base URL for share links, emails and provisioning responses. When unset,
# lib/site-url.ts falls back, in order, to NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_BASE_URL,
# APP_URL, NEXTAUTH_URL, SITE_URL, then Vercel's own VERCEL_URL / VERCEL_BRANCH_URL /
# VERCEL_DEPLOYMENT_URL (set by the platform). Prefer NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Multi-domain (same Vercel project) — host routing in lib/site-hosts.ts + proxy.ts
# NEXT_PUBLIC_CAMERA_ORIGIN=https://camera.messmass.com
# CAMERA_HOSTNAMES=camera.messmass.com,www.camera.messmass.com
# Short links: same app; `/{slug}` on these hosts rewrites to /api/go-short/[slug] → redirect to NEXT_PUBLIC_CAMERA_ORIGIN/capture/{eventMongoId}
# GO_SHORT_HOSTNAMES=go.messmass.com,www.go.messmass.com
# NEXT_PUBLIC_GO_ORIGIN=https://go.messmass.com
# Optional: share login across *.messmass.com (set only if SSO allowlists all callback URLs on those hosts)
# SESSION_COOKIE_DOMAIN=.messmass.com

# When MONGODB_URI + MONGODB_DB are set, login stores tokens in Atlas (`web_sessions`) and keeps a small pointer cookie (recommended for Chrome).
# Set to 1 to force legacy cookie-only sessions (large JWTs may fail in Chrome).
# COOKIE_ONLY_SESSIONS=

NODE_ENV=development

# Production: dev-login, migrate, debug/*, test-db, test-frames stay 404 unless true
# ALLOW_DANGEROUS_DEV_ROUTES=false

# Reserved for signed sessions / crypto (also used to HMAC-sign OAuth PKCE `state` so login works without a pending cookie)
# Also signs the plain (non-Mongo) session cookie; without SESSION_SECRET / SSO_CLIENT_SECRET / OAUTH_PKCE_STATE_SECRET no plain session cookie is issued or accepted (camera#122).
SESSION_SECRET=
# Optional: override secret for OAuth signed state only (else SESSION_SECRET or SSO_CLIENT_SECRET is used)
# OAUTH_PKCE_STATE_SECRET=

# --- Optional: Upstash Redis (REST) — distributed API rate limits on Vercel ---
# Create a database at https://upstash.com and paste REST URL + token.
# If unset, rate limits use in-memory buckets (per serverless instance).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Operator scripts and test harness only (never read by the running app) ---
# SSO database + camera's OAuth client id, for scripts/grant-admin.mjs,
# grant-admin-by-id.mjs and grant-app-permission.mjs (grants app roles directly in SSO).
# SSO_MONGODB_URI=
# SSO_CAMERA_CLIENT_ID=
# Target event (Mongo _id) for the one-off submission maintenance scripts under scripts/.
# EVENT_MONGO_ID=
# Playwright E2E (see playwright.config.ts; `npm run test:e2e:safe` sets these itself).
# PLAYWRIGHT_BASE_URL=
# PLAYWRIGHT_PORT=3100
# PLAYWRIGHT_START_WEB_SERVER=false

# --- Activity log and its weekly CSV (issue 517; RUNBOOK "Activity log and its weekly CSV") ---
# Vercel sends `Authorization: Bearer <CRON_SECRET>` to the weekly cron only when this is set on the project; without it the export route answers 403.
# CRON_SECRET=
# Where the weekly CSV goes (default moldovancsaba@gmail.com).
# ACTIVITY_EXPORT_TO=
# The log is written on the production deployment only; 1 turns it on elsewhere, 0 turns it off.
# ACTIVITY_LOG=
