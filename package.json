{
  "name": "camera",
  "version": "2.10.0",
  "description": "Professional web application for capturing photos with graphical frames, social sharing, event slideshows, and user profile management",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next-with-baseline-env.mjs dev",
    "build": "node scripts/run-next-with-baseline-env.mjs build",
    "start": "next start",
    "lint": "BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true eslint .",
    "gds:validate-manifest": "gds-compliance validate-manifest --manifest ./gds-adoption.json",
    "gds:check": "gds-compliance check --manifest ./gds-adoption.json",
    "type-check": "tsc --noEmit",
    "test:e2e": "BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true playwright test",
    "test:e2e:headed": "BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true playwright test --headed",
    "db:ensure-indexes": "tsx scripts/run-ensure-indexes.ts",
    "db:verify-uri": "tsx scripts/verify-mongo-uri.ts",
    "env:verify": "tsx scripts/verify-env.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "tryon:seed-suits": "tsx scripts/seed-tryon-suits.ts",
    "tryon:verify": "tsx scripts/verify-tryon-prereqs.ts",
    "tryon:reframe": "tsx scripts/reframe-tryon-results.ts",
    "tryon:reconcile-jobs": "tsx scripts/reconcile-tryon-done-jobs.ts",
    "tryon:enable-frame-composition": "tsx scripts/enable-tryon-frame-composition.ts",
    "tryon:worker": "tsx scripts/tryon-worker.ts",
    "postinstall": "node scripts/patch-baseline-browser-mapping.mjs",
    "vercel:link": "npx vercel@latest link",
    "vercel:env-pull": "npx vercel@latest env pull .env.local --yes"
  },
  "keywords": [
    "photo-frames",
    "camera-capture",
    "image-composition",
    "social-sharing",
    "nextjs",
    "mongodb",
    "oauth2",
    "sso"
  ],
  "author": {
    "name": "Csaba Moldovan",
    "email": "moldovancsaba@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moldovancsaba/camera.git"
  },
  "homepage": "https://github.com/moldovancsaba/camera",
  "license": "MIT",
  "dependencies": {
    "@doneisbetter/gds-admin": "3.0.0",
    "@doneisbetter/gds-core": "3.0.0",
    "@doneisbetter/gds-theme": "3.0.0",
    "@mantine/core": "^8.3.6",
    "@mantine/dropzone": "^8.3.6",
    "@mantine/hooks": "^8.3.6",
    "@mantine/modals": "^8.3.6",
    "@mantine/notifications": "^8.3.6",
    "@tabler/icons-react": "^3.44.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.7.0",
    "mongodb": "^6.8.0",
    "next": "16.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@doneisbetter/gds-compliance": "3.0.0",
    "@doneisbetter/gds-eslint-config": "3.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.31",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "18.x || 20.x || 22.x",
    "npm": ">=8.0.0"
  }
}
