{
  "name": "camera",
  "version": "12.2.3",
  "description": "Professional web application for capturing photos with graphical frames, social sharing, event slideshows, and user profile management",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next-with-baseline-env.mjs dev",
    "build": "node scripts/run-next-with-baseline-env.mjs build",
    "start": "next start",
    "lint": "BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true eslint .",
    "gds:validate-manifest": "gds-compliance validate-manifest --manifest ./gds-adoption.json",
    "gds:check": "gds-compliance check --manifest ./gds-adoption.json && node scripts/check-gds-boundaries.mjs",
    "type-check": "tsc --noEmit",
    "release:check": "npm run gds:validate-manifest && npm run gds:check && npm run type-check && npm run lint && npm run verify:production-guards && npm run build",
    "test:e2e": "BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true playwright test",
    "test:e2e:safe": "BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true tsx scripts/run-e2e-safe.ts",
    "test:e2e:headed": "BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true playwright test --headed",
    "db:ensure-indexes": "tsx scripts/run-ensure-indexes.ts",
    "db:verify-uri": "tsx scripts/verify-mongo-uri.ts",
    "env:verify": "tsx scripts/verify-env.ts",
    "verify:production-guards": "tsx scripts/verify-production-guards.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "tryon:seed-suits": "tsx scripts/seed-tryon-suits.ts",
    "tryon:verify": "tsx scripts/verify-tryon-prereqs.ts",
    "tryon:reframe": "tsx scripts/reframe-tryon-results.ts",
    "tryon:reconcile-jobs": "tsx scripts/reconcile-tryon-done-jobs.ts",
    "tryon:backfill-identity": "tsx scripts/backfill-tryon-result-identity.ts",
    "tryon:backfill-identity:apply": "tsx scripts/backfill-tryon-result-identity.ts --apply",
    "tryon:report-unrecoverable-identities": "tsx scripts/report-unrecoverable-tryon-identities.ts",
    "tryon:report-unrecoverable-identities:csv": "tsx scripts/report-unrecoverable-tryon-identities.ts --csv",
    "tryon:apply-identity-corrections": "tsx scripts/apply-tryon-identity-corrections.ts",
    "tryon:apply-identity-corrections:apply": "tsx scripts/apply-tryon-identity-corrections.ts --apply",
    "tryon:audit-data-integrity": "tsx scripts/audit-tryon-data-integrity.ts",
    "tryon:audit-data-integrity:strict": "tsx scripts/audit-tryon-data-integrity.ts --strict",
    "tryon:backfill-superseded-archive-reason": "tsx scripts/backfill-tryon-superseded-archive-reason.ts",
    "tryon:backfill-superseded-archive-reason:apply": "tsx scripts/backfill-tryon-superseded-archive-reason.ts --apply",
    "tryon:enable-frame-composition": "tsx scripts/enable-tryon-frame-composition.ts",
    "tryon:worker": "tsx scripts/tryon-worker.ts",
    "postinstall": "node scripts/patch-baseline-browser-mapping.mjs",
    "vercel:link": "npx vercel@latest link",
    "vercel:env-pull": "npx vercel@latest env pull .env.local --yes",
    "db:migrate-email-template-fields": "tsx scripts/backfill-event-email-template-fields.ts",
    "db:migrate-email-template-fields:apply": "tsx scripts/backfill-event-email-template-fields.ts --apply",
    "db:migrate-email-body-defaults": "tsx scripts/migrate-event-email-body-defaults.ts",
    "db:migrate-email-body-defaults:apply": "tsx scripts/migrate-event-email-body-defaults.ts --apply",
    "db:backfill-event-terms-url": "tsx scripts/backfill-event-terms-url.ts",
    "db:backfill-event-email-sender-name": "tsx scripts/backfill-event-email-sender-name.ts",
    "email:send-today": "tsx scripts/send-today-submission-emails.ts"
  },
  "keywords": [
    "photo-frames",
    "camera-capture",
    "image-composition",
    "social-sharing",
    "nextjs",
    "mongodb",
    "oauth2",
    "sso"
  ],
  "author": {
    "name": "Csaba Moldovan",
    "email": "moldovancsaba@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moldovancsaba/camera.git"
  },
  "homepage": "https://github.com/moldovancsaba/camera",
  "license": "MIT",
  "dependencies": {
    "@mantine/core": "^8.3.6",
    "@mantine/dates": "^8.3.18",
    "@mantine/dropzone": "^8.3.6",
    "@mantine/hooks": "^8.3.6",
    "@mantine/modals": "^8.3.6",
    "@mantine/notifications": "^8.3.6",
    "@sovereignsquad/gds-admin": "file:vendor/gds/sovereignsquad-gds-admin-6.3.0.tgz",
    "@sovereignsquad/gds-core": "file:vendor/gds/sovereignsquad-gds-core-6.3.0.tgz",
    "@sovereignsquad/gds-theme": "file:vendor/gds/sovereignsquad-gds-theme-6.3.0.tgz",
    "@tabler/icons-react": "^3.44.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.0",
    "dayjs": "^1.11.21",
    "mongodb": "^6.8.0",
    "next": "^16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sovereignsquad/gds-compliance": "file:vendor/gds/sovereignsquad-gds-compliance-6.3.0.tgz",
    "@sovereignsquad/gds-eslint-config": "file:vendor/gds/sovereignsquad-gds-eslint-config-6.3.0.tgz",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^6.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.31",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "8.5.15",
    "esbuild": "0.28.1"
  }
}
